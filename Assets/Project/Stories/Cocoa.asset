MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 248fbbbc7420e764f82e02900b5b3e1e, type: 3}
  m_Name: Cocoa
  m_EditorClassIdentifier: 
  title: "\u041A\u0430\u043A\u0430\u043E"
  text: "$pet_name \u0441\u0438\u0434\u0435\u043B \u0432\u043E\u0437\u043B\u0435
    \u043E\u043A\u043D\u0430 \u0438 \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u043B
    \u0437\u0430 \u0442\u0435\u043C, \u043A\u0430\u043A \u0441 \u043D\u0435\u0431\u0430
    \u043B\u044C\u0435\u0442\u0441\u044F \u0432\u043E\u0434\u0430. \u0425\u043E\u0437\u044F\u0438\u043D
    \u0443\u0448\u0435\u043B \u043F\u043E \u0441\u0432\u043E\u0438\u043C \u0434\u0435\u043B\u0430\u043C,
    \u043E\u0441\u0442\u0430\u0432\u0438\u0432 \u0441\u043B\u0430\u0439\u043C\u0430
    \u043E\u0434\u043D\u043E\u0433\u043E \u0434\u043E\u043C\u0430. \u041A\u0430\u043F\u043B\u0438
    \u043B\u0435\u0442\u0435\u043B\u0438 \u0432\u043D\u0438\u0437, \u0431\u0430\u0440\u0430\u0431\u0430\u043D\u044F
    \u043F\u043E \u0441\u0442\u0435\u043A\u043B\u0443. \u0423\u043C\u0438\u0440\u043E\u0442\u0432\u043E\u0440\u0435\u043D\u0438\u0435
    \u0438 \u0440\u0438\u0442\u043C\u0438\u0447\u043D\u043E\u0435 \u043F\u043E\u0441\u0442\u0443\u043A\u0438\u0432\u0430\u043D\u0438\u0435
    \u043E\u0449\u0443\u0449\u0430\u043B\u043E\u0441\u044C \u0432 \u044D\u0442\u043E\u0442
    \u0442\u043E\u043C\u043D\u044B\u0439 \u0432\u0435\u0447\u0435\u0440. \u041D\u0435
    \u0445\u0432\u0430\u0442\u0430\u0435\u0442 \u0442\u043E\u043B\u044C\u043A\u043E
    \u043A\u0430\u043C\u0438\u043D\u0430, \u0443\u044E\u0442\u043D\u043E\u0433\u043E
    \u043F\u043B\u0435\u0434\u0438\u043A\u0430 \u0438 \u043A\u0440\u0443\u0436\u0435\u0447\u043A\u0438
    \u043A\u0430\u043A\u0430\u043E. \u041A\u043E\u043D\u0435\u0447\u043D\u043E, \u0445\u043E\u0437\u044F\u0438\u043D
    \u0433\u043E\u0432\u043E\u0440\u0438\u0442, \u0447\u0442\u043E \u043A\u0430\u043A\u0430\u043E
    \u043C\u043D\u043E\u0433\u043E \u043F\u0438\u0442\u044C \u043D\u0435\u043B\u044C\u0437\u044F,
    \u043E\u0434\u043D\u0430\u043A\u043E \u0440\u0430\u0437\u0432\u0435 \u043C\u043E\u0436\u0435\u0442
    \u0442\u0430\u043A\u043E\u0439 \u0432\u043A\u0443\u0441\u043D\u044B\u0439 \u043D\u0430\u043F\u0438\u0442\u043E\u043A
    \u0431\u044B\u0442\u044C \u0432\u0440\u0435\u0434\u043D\u044B\u043C? $pet_name
    \u0440\u0435\u0448\u0438\u043B, \u0447\u0442\u043E \u043D\u0435\u0442, \u0430
    \u043F\u043E\u0442\u043E\u043C\u0443 \u0440\u0435\u0448\u0438\u043B \u0441\u0430\u043C\u043E\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u043E
    \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C \u0441\u0432\u043E\u0435
    \u043B\u044E\u0431\u0438\u043C\u043E\u0435 \u043B\u0430\u043A\u043E\u043C\u0441\u0442\u0432\u043E.\r\n\u2013
    \u0413\u043B\u0430\u0432\u043D\u043E\u0435 \u2014 \u043D\u0435 \u0437\u0430\u0431\u044B\u0442\u044C
    \u043F\u0440\u043E \u0437\u0435\u0444\u0438\u0440\u043A\u0438!\r\n\u0421\u043F\u0443\u0441\u0442\u0438\u0432\u0448\u0438\u0441\u044C
    \u0441 \u043F\u043E\u0434\u043E\u043A\u043E\u043D\u043D\u0438\u043A\u0430, $pet_name
    \u0437\u0430\u0445\u043B\u044E\u043F\u0430\u043B \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443
    \u043A\u0443\u0445\u043D\u0438. \u0412 \u0435\u0433\u043E \u0433\u043E\u043B\u043E\u0432\u0435
    \u0443\u0436\u0435 \u0431\u044B\u043B\u043E \u0446\u0435\u043B\u043E\u0435 \u043C\u043E\u0440\u0435
    \u043A\u0430\u043A\u0430\u043E, \u0432 \u043A\u043E\u0442\u043E\u0440\u043E\u043C
    \u043E\u043D \u043F\u043B\u0430\u0432\u0430\u043B \u043D\u0430 \u043A\u043E\u0440\u0430\u0431\u043B\u0435
    \u0438\u0437 \u0437\u0435\u0444\u0438\u0440\u043E\u043A.\r\n\u2013 \u042F \u043A\u0430\u043F\u0438\u0442\u0430\u043D
    $pet_name, \u043F\u043E\u0432\u0435\u043B\u0438\u0442\u0435\u043B\u044C \u0441\u043B\u0430\u0434\u043A\u0438\u0445
    \u043C\u043E\u0440\u0435\u0439! \u2013 \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0430\u044F
    \u043F\u0438\u0440\u0430\u0442\u0430, \u043A\u0440\u0438\u043A\u043D\u0443\u043B
    \u0441\u043B\u0430\u0439\u043C, \u2013 \u0413\u0434\u0435 \u043C\u043E\u044F
    \u043A\u043E\u043C\u0430\u043D\u0434\u0430, \u044F\u0440-\u0440?\r\n\u0424\u0430\u043D\u0442\u0430\u0437\u0438\u044F
    \u043F\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043B\u0430 \u043E\u0431\u044B\u0447\u043D\u0443\u044E
    \u043A\u0443\u0445\u043D\u044E \u0432 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0443\u044E
    \u043F\u0430\u043B\u0443\u0431\u0443 \u043A\u043E\u0440\u0430\u0431\u043B\u044F.
    \u041C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0435 \u043C\u0430\u0442\u0440\u043E\u0441\u044B
    \u0441\u0434\u0435\u043B\u0430\u043D\u043D\u044B\u0435 \u0438\u0437 \u0437\u0435\u0444\u0438\u0440\u043E\u043A
    \u0431\u0435\u0433\u0430\u043B\u0438 \u043F\u043E \u043D\u0435\u043C\u0443, \u043D\u0430\u0442\u044F\u0433\u0438\u0432\u0430\u044F
    \u043A\u0430\u043D\u0430\u0442\u044B, \u0434\u0440\u0430\u044F \u043F\u0430\u043B\u0443\u0431\u0443
    \u0438 \u043B\u0430\u0442\u0430\u044F \u0434\u043E\u0441\u043A\u0438. \u0412\u043F\u0435\u0440\u0435\u0434\u0438
    \u0432\u0438\u0434\u043D\u0435\u043B\u0430\u0441\u044C \u0442\u0443\u0447\u0430,
    \u0438\u0437 \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u043B\u0438\u043B\u0430\u0441\u044C
    \u0432\u043E\u0434\u0430. $pet_name \u043D\u0435 \u0438\u0441\u043F\u0443\u0433\u0430\u043B\u0441\u044F.
    \u041E\u043D \u0437\u043D\u0430\u043B, \u0447\u0442\u043E \u0442\u0430\u043C
    \u0435\u0433\u043E \u0436\u0434\u0435\u0442 \u0441\u043E\u043A\u0440\u043E\u0432\u0438\u0449\u0435!
    \u041A\u0430\u043F\u0438\u0442\u0430\u043D \u043D\u0430\u043F\u0440\u0430\u0432\u0438\u043B
    \u043A\u043E\u0440\u0430\u0431\u043B\u044C \u0432\u043D\u0443\u0442\u0440\u044C
    \u0448\u0442\u043E\u0440\u043C\u0430. \u041C\u0430\u0442\u0440\u043E\u0441\u044B
    \u043F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043B\u0438 \u043F\u0440\u0438\u043C\u0435\u0440\u0443
    \u0441\u0432\u043E\u0435\u0433\u043E \u043B\u0438\u0434\u0435\u0440\u0430 \u0438
    \u043D\u0435 \u043F\u043E\u0434\u0434\u0430\u043B\u0438\u0441\u044C \u043F\u0430\u043D\u0438\u043A\u0435.
    \u0421\u0445\u0432\u0430\u0442\u0438\u0432 \u0432\u0435\u0434\u0440\u0430, \u043E\u043D\u0438
    \u043F\u0440\u0438\u043D\u044F\u043B\u0438\u0441\u044C \u0432\u044B\u043B\u0438\u0432\u0430\u0442\u044C
    \u043A\u043E\u043F\u0438\u0432\u0448\u0443\u044E\u0441\u044F \u0432\u043E\u0434\u0443
    \u0437\u0430 \u0431\u043E\u0440\u0442.\r\n\u2013 \u041A\u0430\u043F\u0438\u0442\u0430\u043D
    $pet_name, \u2013 \u043E\u0431\u0440\u0430\u0442\u0438\u043B\u0441\u044F \u0431\u043E\u0446\u043C\u0430\u043D
    \u041C\u0438\u0448\u043A\u0430 \u043A \u0441\u043B\u0430\u0439\u043C\u0443, \u2013
    \u0435\u0441\u043B\u0438 \u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u044C
    \u0432\u0441\u0435\u043C \u0440\u0430\u0441\u0447\u0435\u0442\u0430\u043C, \u0442\u043E
    \u043B\u0435\u0433\u0435\u043D\u0434\u0430\u0440\u043D\u0430\u044F \u043A\u0430\u043A\u0430\u043E-\u043C\u0430\u0448\u0438\u043D\u0430
    \u0434\u043E\u043B\u0436\u043D\u0430 \u0431\u044B\u0442\u044C \u043D\u0430 \u043E\u0441\u0442\u0440\u043E\u0432\u0435
    \u0432\u043D\u0443\u0442\u0440\u0438 \u044D\u0442\u043E\u0433\u043E \u0448\u0442\u043E\u0440\u043C\u0430.\r\n\u0412
    \u0432\u043E\u0437\u0434\u0443\u0445\u0435 \u043F\u043E\u0432\u0438\u0441\u043B\u0430
    \u0434\u0440\u0430\u043C\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0430\u044F
    \u0442\u0438\u0448\u0438\u043D\u0430, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
    \u043D\u0430\u0440\u0443\u0448\u0430\u043B\u0430\u0441\u044C \u043B\u0438\u0448\u044C
    \u0448\u0443\u043C\u043E\u043C \u0432\u0435\u0442\u0440\u0430 \u0438 \u0431\u044C\u044E\u0449\u0438\u0445\u0441\u044F
    \u0432\u043E\u043B\u043D. $pet_name \u0443\u043B\u044B\u0431\u043D\u0443\u043B\u0441\u044F,
    \u0433\u043B\u044F\u0434\u044F \u043D\u0430 \u0442\u043E\u0432\u0430\u0440\u0438\u0449\u0430.\r\n\u2013
    \u041F\u0440\u043E\u0440\u0432\u0435\u043C\u0441\u044F! \u0412\u0435\u0434\u044C
    \u043D\u0435 \u043C\u043E\u0433\u0443\u0442 \u043F\u043E\u0441\u0442\u0443\u043F\u0438\u0442\u044C
    \u0438\u043D\u0430\u0447\u0435 \u043F\u0438\u0440\u0430\u0442\u044B \u0441\u043B\u0430\u0434\u043A\u0438\u0445
    \u043C\u043E\u0440\u0435\u0439!\r\n\u2013 \u0425\u043E\u0439! \u2013 \u043A\u0440\u0438\u043A\u043D\u0443\u043B\u0438
    \u043C\u043E\u0440\u044F\u043A\u0438 \u0440\u0430\u0437\u043E\u043C, \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044F
    \u0441\u0432\u043E\u0435\u0433\u043E \u043A\u0430\u043F\u0438\u0442\u0430\u043D\u0430.\r\n\u041F\u0430\u0440\u0443\u0441
    \u0431\u044B\u043B \u043E\u043F\u0443\u0449\u0435\u043D, \u0438 \u0437\u0435\u0444\u0438\u0440\u043D\u044B\u0435
    \u043F\u0438\u0440\u0430\u0442\u044B \u0441\u0435\u043B\u0438 \u0437\u0430 \u0432\u0435\u0441\u043B\u0430.
    \u0425\u043E\u0442\u044F, \u043A\u043E\u043D\u0435\u0447\u043D\u043E, \u044D\u0442\u043E
    \u0431\u044B\u043B\u043E \u043D\u0435\u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E.
    \u041C\u043E\u0440\u0441\u043A\u043E\u0435 \u0442\u0435\u0447\u0435\u043D\u0438\u0435
    \u0441\u0430\u043C\u043E \u043D\u0435\u0441\u043B\u043E \u043A\u043E\u0440\u0430\u0431\u043B\u044C
    \u0432\u043F\u0435\u0440\u0435\u0434, \u043A \u0437\u0430\u0432\u0435\u0442\u043D\u043E\u043C\u0443
    \u0441\u043E\u043A\u0440\u043E\u0432\u0438\u0449\u0443. \u0421\u043F\u0443\u0441\u0442\u044F
    \u043F\u0430\u0440\u0443 \u0433\u0438\u0433\u0430\u043D\u0442\u0441\u043A\u0438\u0445
    \u0432\u043E\u043B\u043D, \u0447\u0443\u0434\u043E\u043C \u043D\u0435 \u0441\u043C\u044B\u0432\u0448\u0438\u0445
    \u043C\u043E\u0440\u044F\u043A\u043E\u0432, \u0432\u0434\u0430\u043B\u0438 \u043F\u043E\u044F\u0432\u0438\u043B\u0441\u044F
    \u043E\u0441\u0442\u0440\u043E\u0432.\r\n\u2013 \u0417\u0435\u043C\u043B\u044F!
    \u2013 \u043A\u0440\u0438\u043A\u043D\u0443\u043B \u0437\u0435\u0444\u0438\u0440\u043D\u044B\u0439
    \u044E\u043D\u0433\u0430 \u043D\u0430 \u0441\u043C\u043E\u0442\u0440\u043E\u0432\u043E\u0439
    \u043A\u0430\u0431\u0438\u043D\u043A\u0435.\r\n\u0412\u0441\u0435 \u043D\u0430
    \u043A\u043E\u0440\u0430\u0431\u043B\u0435 \u043E\u0436\u0438\u0432\u0438\u043B\u0438\u0441\u044C.
    \u041C\u0430\u0442\u0440\u043E\u0441\u044B \u043D\u0430 \u0432\u0435\u0441\u043B\u0430\u0445
    \u0443\u0441\u043A\u043E\u0440\u0438\u043B\u0438\u0441\u044C, \u0431\u043E\u0446\u043C\u0430\u043D
    \u0438 \u043A\u0430\u043F\u0438\u0442\u0430\u043D $pet_name \u043F\u044B\u0442\u0430\u043B\u0438\u0441\u044C
    \u043D\u0430\u0439\u0442\u0438 \u0431\u0443\u0445\u0442\u0443, \u043A \u043A\u043E\u0442\u043E\u0440\u043E\u0439
    \u043C\u043E\u0436\u043D\u043E \u0431\u044B\u043B\u043E \u0431\u044B \u043F\u0440\u0438\u0447\u0430\u043B\u0438\u0442\u044C.\r\n\u2013
    \u0421\u043C\u043E\u0442\u0440\u0438\u0442\u0435! \u2013 \u0431\u043E\u0446\u043C\u0430\u043D
    \u041C\u0438\u0448\u043A\u0430 \u0443\u043A\u0430\u0437\u0430\u043B \u0432\u043F\u0435\u0440\u0435\u0434.\r\n\u041E\u0441\u0442\u0440\u043E\u0432 
    \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u043B \u0438\u0437
    \u0441\u0435\u0431\u044F \u0431\u043E\u043B\u044C\u0448\u0443\u044E \u043D\u0430\u0441\u044B\u043F\u044C
    \u0441\u0443\u0445\u043E\u0433\u043E \u043A\u0430\u043A\u0430\u043E-\u043F\u043E\u0440\u043E\u0448\u043A\u0430.
    \u041F\u043E\u0440\u0442 \u0436\u0435, \u043A \u043A\u043E\u0442\u043E\u0440\u043E\u043C\u0443
    \u043F\u0440\u0438\u0447\u0430\u043B\u0438\u043B\u0438 \u043F\u0438\u0440\u0430\u0442\u044B,
    \u0431\u044B\u043B \u0441\u0434\u0435\u043B\u0430\u043D \u0438\u0437 \u0448\u043E\u043A\u043E\u043B\u0430\u0434\u043D\u044B\u0445
    \u043F\u043B\u0438\u0442\u043E\u043A. \u0412 \u0441\u0430\u043C\u043E\u0439 \u0433\u043B\u0443\u0431\u0438\u043D\u0435
    \u044D\u0442\u043E\u0433\u043E \u0440\u0430\u0439\u0441\u043A\u043E\u0433\u043E
    \u0443\u0433\u043E\u043B\u043A\u0430 \u043F\u043E\u0441\u0440\u0435\u0434\u0438
    \u0448\u0442\u043E\u0440\u043C\u0430 \u0441\u0442\u043E\u044F\u043B \u0431\u043E\u043B\u044C\u0448\u043E\u0439
    \u0430\u043F\u043F\u0430\u0440\u0430\u0442. \u0412 \u043D\u0435\u043C \u0441\u043C\u0435\u0448\u0438\u0432\u0430\u043B\u043E\u0441\u044C
    \u043C\u043E\u043B\u043E\u043A\u043E, \u043A\u0430\u043A\u0430\u043E \u0438 \u0437\u0435\u0444\u0438\u0440\u043A\u0438.
    \u041A\u0430\u043F\u0438\u0442\u0430\u043D $pet_name \u043F\u0440\u0438\u043A\u0430\u0437\u0430\u043B
    \u0437\u0430\u0441\u044B\u043F\u0430\u0442\u044C \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u044B\u0435
    \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044B. \u041A\u043E\u043C\u0430\u043D\u0434\u0430
    \u043F\u043E\u0441\u043B\u0443\u0448\u043D\u043E \u043F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043B\u0430
    \u043F\u0440\u0438\u043A\u0430\u0437\u0443.\r\n\u2013 \u041A\u0430\u043F\u0438\u0442\u0430\u043D,
    \u2013 \u0431\u043E\u0446\u043C\u0430\u043D \u041C\u0438\u0448\u043A\u0430 \u0441
    \u0443\u043B\u044B\u0431\u043A\u043E\u0439 \u043F\u0440\u043E\u0442\u044F\u0433\u0438\u0432\u0430\u043B
    \u043A\u0440\u0443\u0436\u0435\u0447\u043A\u0443 \u0433\u043E\u0440\u044F\u0447\u0435\u0433\u043E
    \u043A\u0430\u043A\u0430\u043E \u0441\u043B\u0430\u0439\u043C\u0443.\r\n$pet_name
    \u0441\u0434\u0435\u043B\u0430\u043B \u0433\u043B\u043E\u0442\u043E\u043A \u0438
    \u0443\u0434\u043E\u0432\u043B\u0435\u0442\u0432\u043E\u0440\u0435\u043D\u043D\u043E
    \u0432\u044B\u0434\u043E\u0445\u043D\u0443\u043B, \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u044F
    \u0433\u043B\u0430\u0437\u0430. \u0422\u0435\u043F\u043B\u043E, \u043E\u043A\u0443\u0442\u044B\u0432\u0430\u044E\u0449\u0435\u0435
    \u0441\u043B\u0430\u0439\u043C\u0430, \u043E\u043A\u043E\u043D\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u043E
    \u0443\u043D\u0435\u0441\u043B\u043E \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u043E\u0433\u043E
    \u043F\u0440\u043E\u043A\u0430\u0437\u043D\u0438\u043A\u0430 \u0432 \u043C\u0438\u0440
    \u0441\u043D\u043E\u0432.\r"
