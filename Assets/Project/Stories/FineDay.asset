MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 248fbbbc7420e764f82e02900b5b3e1e, type: 3}
  m_Name: FineDay
  m_EditorClassIdentifier: 
  title: "\u041F\u043E\u0433\u043E\u0436\u0438\u0439 \u0434\u0435\u043D\u0435\u043A"
  text: "\u041D\u0430 \u0434\u0432\u043E\u0440\u0435 \u0431\u044B\u043B \u043F\u043E\u0433\u043E\u0436\u0438\u0439
    \u0434\u0435\u043D\u0435\u043A. \u0421\u043E\u043B\u043D\u0446\u0435 \u0432\u0435\u0441\u0435\u043B\u043E
    \u0438\u0433\u0440\u0430\u043B\u043E \u043B\u0443\u0447\u0430\u043C\u0438, \u0432\u0435\u0442\u0435\u0440
    \u043A\u043E\u043B\u044B\u0445\u0430\u043B \u0432\u0435\u0442\u0432\u0438 \u043C\u043E\u0433\u0443\u0447\u0435\u0433\u043E
    \u0434\u0443\u0431\u0430, \u043F\u0442\u0438\u0447\u043A\u0438 \u0440\u0430\u0441\u043F\u0435\u0432\u0430\u043B\u0438
    \u0447\u0443\u0434\u043D\u0443\u044E \u043C\u0435\u043B\u043E\u0434\u0438\u044E.
    \u042D\u0442\u043E \u0431\u044B\u043B \u0437\u0430\u0434\u043D\u0438\u0439 \u0434\u0432\u043E\u0440
    \u0445\u043E\u0437\u044F\u0438\u043D\u0430 \u0441\u043B\u0430\u0439\u043C\u0430.
    $pet_name \u0441 \u0443\u0434\u043E\u0432\u043E\u043B\u044C\u0441\u0442\u0432\u0438\u0435\u043C
    \u0440\u0430\u0437\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u043B \u0443\u043B\u0438\u0446\u0443
    \u0447\u0435\u0440\u0435\u0437 \u043E\u043A\u043D\u043E. \u0415\u043C\u0443 \u043E\u0447\u0435\u043D\u044C
    \u0445\u043E\u0442\u0435\u043B\u043E\u0441\u044C \u043F\u043E\u0433\u0443\u043B\u044F\u0442\u044C
    \u0438 \u043F\u043E\u0442\u043E\u043C\u0443 \u043E\u043D \u0440\u0435\u0448\u0438\u043B
    \u043F\u043E\u043A\u0438\u043D\u0443\u0442\u044C \u0434\u043E\u043C. \u041F\u0440\u0438\u043E\u0442\u043A\u0440\u044B\u0432
    \u043E\u043A\u043E\u043D\u0446\u0435, \u0441\u043B\u0430\u0439\u043C \u043F\u0440\u043E\u0441\u043E\u0447\u0438\u043B\u0441\u044F
    \u0447\u0435\u0440\u0435\u0437 \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u0432\u0448\u0435\u0435\u0441\u044F
    \u043E\u0442\u0432\u0435\u0440\u0441\u0442\u0438\u0435 \u0438 \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
    \u0441\u043D\u0430\u0440\u0443\u0436\u0438. \u041F\u0440\u0438\u044F\u0442\u043D\u043E\u0435
    \u0441\u043E\u043B\u043D\u0435\u0447\u043D\u043E\u0435 \u0442\u0435\u043F\u043B\u043E
    \u0442\u0443\u0442 \u0436\u0435 \u043F\u0440\u0438\u043D\u044F\u043B\u043E \u0435\u0433\u043E
    \u0432 \u0441\u0432\u043E\u0438 \u043E\u0431\u044A\u044F\u0442\u0438\u044F. $pet_name
    \u043F\u0440\u0438\u043A\u0440\u044B\u043B \u0433\u043B\u0430\u0437\u0430 \u0438
    \u043F\u0440\u0438\u043D\u044F\u043B\u0441\u044F \u043D\u0430\u0441\u043B\u0430\u0436\u0434\u0430\u0442\u044C\u0441\u044F
    \u0442\u043E\u0439 \u043D\u0435\u043C\u043D\u043E\u0433\u043E\u0439 \u043F\u0440\u0438\u0440\u043E\u0434\u043E\u0439,
    \u0447\u0442\u043E \u0435\u0449\xEB \u043E\u0441\u0442\u0430\u043B\u0430\u0441\u044C
    \u0432 \u0433\u043E\u0440\u043E\u0434\u0435.\r\n\u2013 \u0427\u0438\u0440\u0438\u043A-\u0447\u0438\u0440\u0438\u043A,
    \u2013 \u043D\u0430 \u0432\u0435\u0442\u043A\u0435 \u0434\u0443\u0431\u0430 \u0441\u0438\u0434\u0435\u043B
    \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u0432\u043E\u0440\u043E\u0431\u0443\u0448\u0435\u043A
    \u0438 \u0437\u0430\u0434\u043E\u0440\u043D\u043E \u0447\u0438\u0440\u0438\u043A\u0430\u043B,
    \u0433\u043B\u044F\u0434\u044F \u043D\u0430 \u0441\u043B\u0430\u0439\u043C\u0430.\r\n\u2013
    \u0427\u0438\u0440\u0438\u043A! \u2013 \u043E\u0442\u0432\u0435\u0442\u0438\u043B
    \u0435\u043C\u0443 $pet_name.\r\n\u2013 \u0414\u0430, \u0442\u0430\u043A \u043C\u0435\u043D\u044F
    \u0437\u043E\u0432\u0443\u0442. \u0410 \u0442\u0432\u043E\u0435 \u0438\u043C\u044F?
    \u2013 \u043D\u0435\u043E\u0436\u0438\u0434\u0430\u043D\u043D\u043E \u0434\u043B\u044F
    \u0441\u043B\u0430\u0439\u043C\u0430 \u043F\u0440\u043E\u0449\u0435\u0431\u0435\u0442\u0430\u043B
    \u0432\u043E\u0440\u043E\u0431\u0443\u0448\u0435\u043A.\r\n\u2013 \u042F $pet_name!
    \u0422\u044B \u0433\u043E\u0432\u043E\u0440\u044F\u0449\u0438\u0439?\r\n\u2013
    \u041A\u043E\u043D\u0435\u0447\u043D\u043E, \u0442\u044B \u0432\u0435\u0434\u044C
    \u0442\u043E\u0436\u0435 \u0433\u043E\u0432\u043E\u0440\u044F\u0449\u0438\u0439.
    \u041F\u043E\u0447\u0435\u043C\u0443 \u044F \u043D\u0435 \u0434\u043E\u043B\u0436\u0435\u043D
    \u0443\u043C\u0435\u0442\u044C \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C?
    \u2013 \u0443\u0434\u0438\u0432\u0438\u043B\u0430\u0441\u044C \u043F\u0442\u0438\u0447\u043A\u0430,
    \u0441\u043F\u0443\u0441\u043A\u0430\u044F\u0441\u044C \u043F\u043E\u0431\u043B\u0438\u0436\u0435
    \u043A \u0441\u043B\u0430\u0439\u043C\u0443.\r\n$pet_name \u0443\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E
    \u043A\u0438\u0432\u043D\u0443\u043B, \u0441\u043E\u0433\u043B\u0430\u0448\u0430\u044F\u0441\u044C
    \u0441 \u0434\u043E\u0432\u043E\u0434\u043E\u043C \u0427\u0438\u0440\u0438\u043A\u0430.
    \u041F\u0442\u0438\u0447\u043A\u0430 \u0432 \u0441\u0432\u043E\u044E \u043E\u0447\u0435\u0440\u0435\u0434\u044C
    \u043F\u043E\u0434\u043B\u0435\u0442\u0435\u043B\u0430 \u0441\u043E\u0432\u0441\u0435\u043C
    \u0431\u043B\u0438\u0437\u043A\u043E \u0438 \u043F\u0440\u0438\u0437\u0435\u043C\u043B\u0438\u043B\u0430\u0441\u044C
    \u0432\u043E\u0437\u043B\u0435 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0433\u043E
    \u043F\u0438\u0442\u044C\u0435\u0432\u043E\u0433\u043E \u0444\u043E\u043D\u0442\u0430\u043D\u0430,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0441\u043E\u0432\u0441\u0435\u043C
    \u043D\u0435\u0434\u0430\u0432\u043D\u043E \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B
    \u0445\u043E\u0437\u044F\u0438\u043D.\r\n\u2013 \u0421\u043B\u0443\u0448\u0430\u0439,
    $pet_name, \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0442\u0430\u043A\u043E\u0439
    \u0436\u0430\u0440\u043A\u0438\u0439 \u0434\u0435\u043D\u044C. \u0414\u0430\u0436\u0435
    \u043A\u0440\u043E\u043D\u0430 \u044D\u0442\u043E\u0433\u043E \u043C\u043E\u0433\u0443\u0447\u0435\u0433\u043E
    \u0434\u0443\u0431\u0430 \u043D\u0435 \u0441\u043F\u0430\u0441\u0430\u0435\u0442
    \u043E\u0442 \u0436\u0430\u0440\u044B. \u041D\u0435 \u043C\u043E\u0433 \u0431\u044B
    \u0442\u044B \u0432\u043A\u043B\u044E\u0447\u0438\u0442\u044C \u0432\u043E\u043B\u0448\u0435\u0431\u043D\u044B\u0439
    \u043A\u0440\u0430\u043D? \u2013 \u0427\u0438\u0440\u0438\u043A \u0443\u043A\u0430\u0437\u0430\u043B
    \u043A\u0440\u044B\u043B\u043E\u043C \u043D\u0430 \u0441\u0432\u0435\u0440\u043A\u0430\u044E\u0449\u0443\u044E
    \u043F\u043E\u0434 \u0441\u043E\u043B\u043D\u0435\u0447\u043D\u044B\u043C\u0438
    \u043B\u0443\u0447\u0430\u043C\u0438 \u0442\u0440\u0443\u0431\u043A\u0443.\r\n$pet_name
    \u0431\u0435\u0437 \u043B\u0438\u0448\u043D\u0438\u0445 \u0432\u043E\u043F\u0440\u043E\u0441\u043E\u0432
    \u043F\u043E\u043A\u0440\u0443\u0442\u0438\u043B \u043A\u0440\u0430\u043D\u0438\u043A.
    \u041D\u0435\u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u0432\u0440\u0435\u043C\u044F
    \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u043B\u043E,
    \u043E\u0434\u043D\u0430\u043A\u043E \u0443\u0436\u0435 \u0447\u0435\u0440\u0435\u0437
    \u043F\u0430\u0440\u0443 \u0441\u0435\u043A\u0443\u043D\u0434 \u0442\u043E\u043D\u043A\u0430\u044F
    \u0441\u0442\u0440\u0443\u0439\u043A\u0430 \u043F\u0440\u043E\u0445\u043B\u0430\u0434\u043D\u043E\u0439
    \u0432\u043E\u0434\u044B \u043F\u043E\u0431\u0435\u0436\u0430\u043B\u0430 \u0432\u043D\u0438\u0437.
    \u0412\u043E\u0440\u043E\u0431\u0443\u0448\u0435\u043A \u0440\u0430\u0434\u043E\u0441\u0442\u043D\u043E
    \u0437\u0430\u043C\u0430\u0445\u0430\u043B \u043A\u0440\u044B\u043B\u044C\u044F\u043C\u0438
    \u0438 \u043F\u0440\u0438\u043D\u044F\u043B\u0441\u044F \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E
    \u043F\u0438\u0442\u044C \u043E\u0441\u0432\u0435\u0436\u0430\u044E\u0449\u0443\u044E
    \u0436\u0438\u0434\u043A\u043E\u0441\u0442\u044C. \u0421\u043B\u0430\u0439\u043C
    \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u043B \u0437\u0430 \u043D\u043E\u0432\u044B\u043C
    \u043F\u0440\u0438\u044F\u0442\u0435\u043B\u0435\u043C, \u0440\u0430\u0437\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u044F
    \u0435\u0433\u043E \u043F\u0435\u0440\u044B\u0448\u043A\u0438, \u0447\u0442\u043E
    \u0438\u0437\u0440\u0435\u0434\u043A\u0430 \u043A\u043E\u043B\u044B\u0445\u0430\u043B\u0438\u0441\u044C
    \u043D\u0430 \u0432\u0435\u0442\u0440\u0443. \u041A\u043E\u0440\u0438\u0447\u043D\u0435\u0432\u043E\u0435
    \u043E\u043F\u0435\u0440\u0435\u043D\u0438\u0435 \u0431\u044B\u043B\u043E \u0442\u0430\u043A\u0438\u043C
    \u043A\u0440\u0430\u0441\u0438\u0432\u044B\u043C, \u0447\u0442\u043E \u0441\u043B\u0430\u0439\u043C
    \u043D\u0430 \u0441\u0435\u043A\u0443\u043D\u0434\u0443 \u0437\u0430\u0445\u043E\u0442\u0435\u043B
    \u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C \u043E\u0434\u043D\u043E \u043F\u0435\u0440\u044B\u0448\u043A\u0435
    \u0441\u0435\u0431\u0435, \u043E\u0434\u043D\u0430\u043A\u043E \u0431\u044B\u0441\u0442\u0440\u043E
    \u043F\u0435\u0440\u0435\u0434\u0443\u043C\u0430\u043B.\r\n\u2013 \u041D\u0440\u0430\u0432\u0438\u0442\u0441\u044F?
    \u2013 \u0441\u043F\u0440\u043E\u0441\u0438\u043B \u0427\u0438\u0440\u0438\u043A,
    \u043D\u0430\u043F\u0438\u0432\u0448\u0438\u0441\u044C.\r\n\u041E\u043D \u0433\u043E\u0440\u0434\u043E
    \u0440\u0430\u0441\u043F\u0440\u0430\u0432\u0438\u043B \u043A\u0440\u044B\u043B\u044C\u044F,
    \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u044F \u0432\u0441\u044E \u043A\u0440\u0430\u0441\u043E\u0442\u0443
    \u0441\u0432\u043E\u0435\u0433\u043E \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u043E\u0433\u043E
    \u0445\u0440\u0443\u043F\u043A\u043E\u0433\u043E \u0442\u0435\u043B\u044C\u0446\u0430.\r\n\u2013
    \u041E\u0447\u0435\u043D\u044C! \u2013 \u0443\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E
    \u0437\u0430\u043A\u0438\u0432\u0430\u043B $pet_name, \u0433\u043B\u044F\u0434\u044F
    \u043D\u0430 \u043F\u0442\u0438\u0447\u043A\u0443 \u0437\u0430\u0432\u043E\u0440\u043E\u0436\u0435\u043D\u043D\u044B\u043C\u0438
    \u0433\u043B\u0430\u0437\u0430\u043C\u0438.\r\n\u2013 \u0414\u0435\u0440\u0436\u0438,
    \u2013 \u043F\u0442\u0438\u0447\u043A\u0430 \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E
    \u0432\u044B\u0434\u0435\u0440\u043D\u0443\u043B\u0430 \u043A\u043B\u044E\u0432\u043E\u043C
    \u043F\u0435\u0440\u044B\u0448\u043A\u043E \u0438 \u043F\u0440\u043E\u0442\u044F\u043D\u0443\u043B\u0430
    \u043F\u043E\u0434\u0430\u0440\u043E\u043A \u0441\u043B\u0430\u0439\u043C\u0443.\r\n\u0421\u0432\u0435\u0442\u044F\u0441\u044C
    \u043E\u0442 \u0440\u0430\u0434\u043E\u0441\u0442\u0438, $pet_name \u043F\u0440\u0438\u043D\u044F\u043B
    \u043F\u043E\u0434\u0430\u0440\u043E\u043A \u0427\u0438\u0440\u0438\u043A\u0430.\r\n\u2013
    \u0411\u0443\u0434\u0435\u043C \u0434\u0440\u0443\u0437\u044C\u044F\u043C\u0438!
    \u2013 \u043F\u0440\u043E\u0449\u0435\u0431\u0435\u0442\u0430\u043B \u0432\u043E\u0440\u043E\u0431\u0443\u0448\u0435\u043A
    \u0438 \u0432\u0437\u043C\u044B\u043B \u0432 \u0432\u043E\u0437\u0434\u0443\u0445.\r\n\u041D\u0435\u043A\u043E\u0442\u043E\u0440\u043E\u0435
    \u0432\u0440\u0435\u043C\u044F \u043E\u043D \u043B\u0435\u0442\u0430\u043B \u043D\u0430\u0434
    \u0434\u0432\u043E\u0440\u0438\u043A\u043E\u043C, \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u044F
    \u0443\u043B\u0435\u0442\u043D\u044B\u0435 \u0432\u0438\u0440\u0430\u0436\u0438
    \u043D\u043E\u0432\u043E\u043C\u0443 \u0434\u0440\u0443\u0433\u0443. \u0421\u043B\u0430\u0439\u043C
    \u0432\u043E\u0441\u0442\u043E\u0440\u0436\u0435\u043D\u043D\u043E \u043F\u0440\u044B\u0433\u0430\u043B,
    \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u044F \u0437\u0430 \u043F\u043E\u043B\u0435\u0442\u043E\u043C
    \u0427\u0438\u0440\u0438\u043A\u0430. \u0421\u043F\u0443\u0441\u0442\u044F \u043F\u0430\u0440\u0443
    \u043C\u0438\u043D\u0443\u0442, \u0432\u043E\u0440\u043E\u0431\u0435\u0439 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
    \u0440\u0430\u0437 \u0443\u0441\u0435\u043B\u0441\u044F \u043D\u0430 \u0432\u0435\u0442\u043A\u0443
    \u0434\u0443\u0431\u0430, \u043F\u043E\u043C\u0430\u0445\u0430\u043B \u043A\u0440\u044B\u043B\u043E\u043C
    \u0438 \u043F\u043E\u043B\u0435\u0442\u0435\u043B \u043F\u043E \u0441\u0432\u043E\u0438\u043C
    \u0434\u0435\u043B\u0430\u043C.\r\n\u2013 \u041F\u043E\u043A\u0430! \u2013 \u0442\u0438\u0445\u043E
    \u043F\u0440\u043E\u0448\u0435\u043F\u0442\u0430\u043B $pet_name, \u0443\u043B\u044B\u0431\u0430\u044F\u0441\u044C.\r\n\u041D\u0435\u0441\u044F
    \u0432\u043E \u0440\u0442\u0443 \u043F\u043E\u0434\u0430\u0440\u043E\u043A \u0427\u0438\u0440\u0438\u043A\u0430,
    \u0441\u043B\u0430\u0439\u043C \u0447\u0442\u043E-\u0442\u043E \u0432\u0435\u0441\u0435\u043B\u043E
    \u043D\u0430\u043F\u0435\u0432\u0430\u043B \u0441\u0435\u0431\u0435 \u043F\u043E\u0434
    \u043D\u043E\u0441. \u041F\u043E\u0440\u0430 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0442\u044C\u0441\u044F
    \u0434\u043E\u043C\u043E\u0439.\r"
